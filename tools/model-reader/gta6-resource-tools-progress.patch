+/// Issue #2 in ViceModVI-XBOX: `audio.rpf` holds a 305-member sequence
+/// that decodes to about 19 MiB. The inventory accepted it, but extraction
+/// stopped at the 16 MiB default and failed the whole validation.
+#[test]
+fn extracts_sequences_above_16_mib() {
+    let mut archive = vec![0; 0x2000];
+    header(&mut archive, 0, 1);
+    header(&mut archive, 0x1000, 1);
+    let object: Vec<u8> = (0..257 * CHUNK + 1000).map(|i| (i % 253) as u8).collect();
+    assert!(object.len() > 16 * 1024 * 1024);
+    for part in object.chunks(CHUNK) {
+        let mut encoder = ZlibEncoder::new(Vec::new(), Compression::fast());
+        encoder.write_all(part).unwrap();
+        archive.extend(encoder.finish().unwrap());
+        archive.resize(archive.len().next_multiple_of(16), 0);
+    }
+    archive.resize(archive.len() + 0x1000, 0);
+
+    let mut input = Cursor::new(&archive);
+    let inv = inventory(&mut input).unwrap();
+    let entry = inv.find(Selector::Offset(0x2000)).unwrap();
+    assert_eq!((entry.evidence, entry.chunks, entry.decoded_len), (Evidence::ZlibSequence, 258, object.len()));
+    assert_eq!(extract(&mut input, entry, Payload::Decoded).unwrap(), object);
+}
