--- a/02-rpf-index-extractor/src/tests.rs
+++ b/02-rpf-index-extractor/src/tests.rs
@@ -290,3 +290,56 @@ fn groups_zero_prefixed_spans_into_families() {
     extract_all(&mut input, &inv, |e, p, _| { payloads.push((e.evidence, p)); Ok(()) }).unwrap();
