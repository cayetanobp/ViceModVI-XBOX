<Window x:Class="ViceModVI.Desktop.Workbench"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViceModVI for Xbox" Width="1280" Height="830" MinWidth="850" MinHeight="580"
        Background="#EAF0ED" FontFamily="Segoe UI" FontSize="13" Closing="CloseWindow">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Teal}" Padding="20,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#F8FAF9" FontSize="24"
                           FontWeight="DemiBold" Margin="0,0,28,0" Text="ViceModVI for Xbox"/>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Open folder" Click="OpenFolder"/>
                    <Button Content="Open file" Click="OpenFile"/>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLine" Text="Open a folder or an Xbox Series RPF or TTPF file."
                           Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#415B62">
                    <Run Text="© "/><Hyperlink NavigateUri="https://github.com/cayetanobp/ViceModVI-XBOX"
                                               RequestNavigate="OpenRepository">ViceModVI-XBOX</Hyperlink>
                </TextBlock>
                <ProgressBar Grid.Column="2" x:Name="WorkProgress" HorizontalAlignment="Right" Width="160" Height="12"
                             Margin="12,0,0,0" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="190"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="224" MinWidth="192"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Assets" FontSize="17" FontWeight="SemiBold"/>
                    <TreeView DockPanel.Dock="Top" x:Name="SourceTree" MaxHeight="170" MinHeight="62" Margin="0,8,0,4"
                              AutomationProperties.Name="Source folders and archives" SelectedItemChanged="SelectSource"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock DockPanel.Dock="Top" x:Name="ScopePath" Foreground="#415B62" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                    <ComboBox DockPanel.Dock="Top" x:Name="TypeFilter" SelectedIndex="0" Margin="0,3,0,4"
                              AutomationProperties.Name="Asset type" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All assets"/>
                        <ComboBoxItem Content="Models" Tag="model"/>
                        <ComboBoxItem Content="Textures" Tag="texture"/>
                        <ComboBoxItem Content="Dictionaries" Tag="dictionary"/>
                        <ComboBoxItem Content="Unknown ranges" Tag="unknown"/>
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Top" Text="Name, source, hash, or offset" Foreground="#415B62" Margin="0,4"/>
                    <TextBox DockPanel.Dock="Top" x:Name="Search" Padding="7" Margin="0,0,0,8"
                             AutomationProperties.Name="Search catalog" TextChanged="FilterChanged"/>
                    <ListBox x:Name="AssetList" SelectionChanged="SelectAsset" SelectionMode="Extended"
                             PreviewMouseRightButtonDown="SelectContextAsset" AutomationProperties.Name="Catalog assets"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="PrepareExportMenu">
                                <MenuItem Header="Export selection…" Click="ExportSelection"/>
                                <MenuItem Header="Export staged DDS…" Click="ExportStaged" Visibility="Collapsed"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,4" ToolTip="{Binding SourcePath}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#415B62" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Background="#DCE8E9" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="AssetHeading" Text="Preview" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" x:Name="CompareControls" Visibility="Collapsed"
                                Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="ShowOriginal" GroupName="PreviewMode" Content="Original" IsChecked="True"
                                     Margin="0,0,18,0" Checked="PreviewModeChanged"/>
                        <RadioButton x:Name="ShowReplacement" GroupName="PreviewMode" Content="Replacement"
                                     IsEnabled="False" Checked="PreviewModeChanged"/>
                    </StackPanel>
                    <Grid ClipToBounds="True" Background="#C9DCDD">
                        <TextBlock x:Name="EmptyPreview" Text="Select a model or texture" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="TextureImage" Stretch="Uniform" Visibility="Collapsed" Margin="12"/>
                        <Viewport3D x:Name="Viewport" Visibility="Collapsed" MouseLeftButtonDown="OrbitStart"
                                    MouseLeftButtonUp="OrbitEnd" MouseMove="OrbitMove" MouseWheel="Zoom">
                            <Viewport3D.Camera><PerspectiveCamera x:Name="Camera" FieldOfView="40"/></Viewport3D.Camera>
                            <ModelVisual3D x:Name="ModelScene"/>
                        </Viewport3D>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="4" Background="{StaticResource Paper}" Padding="11" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AssetDetails" Foreground="#415B62" FontSize="11" TextWrapping="Wrap" Margin="0,6"/>
                        <StackPanel x:Name="MeshControls" Visibility="Collapsed">
                            <TextBlock Text="Mesh" FontSize="11" Margin="0,3"/>
                            <ComboBox x:Name="Meshes" AutomationProperties.Name="Mesh" SelectionChanged="SelectMesh"/>
                            <TextBlock Text="Material" FontSize="11" Margin="0,7,0,3"/>
                            <ComboBox x:Name="Materials" AutomationProperties.Name="Material" SelectionChanged="SelectMaterial"/>
                            <TextBlock x:Name="LinkDetails" TextWrapping="Wrap" FontSize="11" Margin="0,6"/>
                            <Button x:Name="ShowLinked" Content="View linked texture" Click="ViewLinkedTexture"
                                    Visibility="Collapsed" Margin="0,0,0,5" Padding="6"/>
                        </StackPanel>
                        <TextBlock x:Name="TextureDetails" TextWrapping="Wrap" FontSize="11" Margin="0,5"/>
                        <Expander x:Name="EditPanel" Header="Edit texture" Visibility="Collapsed" Margin="0,4,0,0">
                            <StackPanel Margin="0,5,0,0">
                                <Button Content="Import replacement…" Click="ImportReplacement" Margin="0,0,0,5" Padding="6"/>
                                <TextBlock x:Name="EditDetails" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,6" Foreground="#415B62"/>
                                <Button x:Name="ConvertButton" Content="Convert for TTPF export…" Click="ConvertForPool"
                                        Visibility="Collapsed" Margin="0,0,0,5" Padding="6"/>
                                <Button x:Name="RevertButton" Content="Revert replacement" Click="RevertReplacement"
                                        Visibility="Collapsed" Margin="0" Padding="6"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
