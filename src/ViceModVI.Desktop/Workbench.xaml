<Window x:Class="ViceModVI.Desktop.Workbench"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViceModVI for Xbox" Width="1280" Height="830" MinWidth="850" MinHeight="580"
        Background="{StaticResource Paper}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" Closing="CloseWindow">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <Menu DockPanel.Dock="Left" Style="{StaticResource CommandMenu}" Margin="0,0,14,0">
                    <MenuItem Header="_Open ▾" Style="{StaticResource MenuTrigger}" AutomationProperties.Name="Open">
                        <MenuItem Header="Open _file…" Click="OpenFile"/>
                        <MenuItem Header="Open f_older…" Click="OpenFolder"/>
                    </MenuItem>
                </Menu>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="250" Margin="0,0,8,0">
                        <TextBox x:Name="Search" Padding="8,4" MinHeight="30" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource Divider}" AutomationProperties.Name="Search catalog"
                                 ToolTip="Search by name, source, hash, or offset" TextChanged="FilterChanged"/>
                        <TextBlock Text="Search assets" Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="TypeFilter" Width="132" SelectedIndex="0" AutomationProperties.Name="Asset type"
                              SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All assets"/>
                        <ComboBoxItem Content="Models" Tag="model"/>
                        <ComboBoxItem Content="Textures" Tag="texture"/>
                        <ComboBoxItem Content="Dictionaries" Tag="dictionary"/>
                        <ComboBoxItem Content="Unknown ranges" Tag="unknown"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="ScopePath" Text="No source open" Margin="0,0,14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <ProgressBar x:Name="WorkProgress" DockPanel.Dock="Right" Width="150" Height="5"
                             Margin="12,0,0,0" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="StatusLine" Text="Ready" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="205"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2.6*" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="244" MinWidth="190"/>
            </Grid.ColumnDefinitions>
            <Grid Background="{StaticResource Paper}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="94"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="2*" MinHeight="154"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sources" Style="{StaticResource PaneHeading}"
                               Margin="14,12,12,8"/>
                    <TreeView x:Name="SourceTree" Margin="8,0,8,4" BorderThickness="0"
                              AutomationProperties.Name="Source folders and archives" SelectedItemChanged="SelectSource"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="MinHeight" Value="24"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                              Background="{StaticResource Panel}" BorderBrush="{StaticResource Divider}"
                              BorderThickness="0,1,0,0" AutomationProperties.Name="Resize sources and assets"/>
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Assets" Style="{StaticResource PaneHeading}"
                               Margin="14,9,12,8"/>
                    <ListBox x:Name="AssetList" BorderThickness="0" Margin="8,0,8,6"
                             SelectionChanged="SelectAsset" SelectionMode="Extended"
                             PreviewMouseRightButtonDown="SelectContextAsset" AutomationProperties.Name="Catalog assets"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="PrepareExportMenu">
                                <MenuItem Header="Export selection…" Click="ExportSelection"/>
                                <MenuItem Header="Export staged DDS…" Click="ExportStaged" Visibility="Collapsed"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,4" ToolTip="{Binding SourcePath}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{StaticResource Panel}" BorderBrush="{StaticResource Divider}"
                          BorderThickness="1,0,0,0" AutomationProperties.Name="Resize browser and preview"/>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                        Padding="16,11">
                    <TextBlock x:Name="AssetHeading" Text="Preview" TextTrimming="CharacterEllipsis"
                               FontSize="16" FontWeight="SemiBold" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Border>
                <Border x:Name="CompareControls" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ShowOriginal" GroupName="PreviewMode" Content="Original" IsChecked="True"
                                     Margin="0,0,18,0" Checked="PreviewModeChanged"/>
                        <RadioButton x:Name="ShowReplacement" GroupName="PreviewMode" Content="Replacement"
                                     IsEnabled="False" Checked="PreviewModeChanged"/>
                    </StackPanel>
                </Border>
                <Grid ClipToBounds="True" Background="{StaticResource Canvas}">
                    <TextBlock x:Name="EmptyPreview" Text="Open an archive or folder to get started."
                               Foreground="{StaticResource Paper}" Opacity="0.86" Margin="20"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="TextureImage" Stretch="Uniform" Visibility="Collapsed" Margin="14"/>
                    <Viewport3D x:Name="Viewport" Visibility="Collapsed" MouseLeftButtonDown="OrbitStart"
                                MouseLeftButtonUp="OrbitEnd" MouseMove="OrbitMove" MouseWheel="Zoom">
                        <Viewport3D.Camera><PerspectiveCamera x:Name="Camera" FieldOfView="40"/></Viewport3D.Camera>
                        <ModelVisual3D x:Name="ModelScene"/>
                    </Viewport3D>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{StaticResource Panel}" BorderBrush="{StaticResource Divider}"
                          BorderThickness="0,0,1,0" AutomationProperties.Name="Resize preview and inspector"/>

            <DockPanel Grid.Column="4" Background="{StaticResource Panel}">
                <TextBlock DockPanel.Dock="Top" Text="Inspector" Style="{StaticResource PaneHeading}"
                           Margin="14,12,14,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,0,14,14">
                        <TextBlock x:Name="AssetDetails" Style="{StaticResource DetailText}" Margin="0,0,0,12"/>
                        <StackPanel x:Name="MeshControls" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Mesh" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="Meshes" AutomationProperties.Name="Mesh" SelectionChanged="SelectMesh"/>
                            <TextBlock Text="Material" Foreground="{StaticResource Muted}" Margin="0,10,0,4"/>
                            <ComboBox x:Name="Materials" AutomationProperties.Name="Material" SelectionChanged="SelectMaterial"/>
                            <TextBlock x:Name="LinkDetails" Style="{StaticResource DetailText}" Margin="0,8,0,4"/>
                            <Button x:Name="ShowLinked" Content="View linked texture" Click="ViewLinkedTexture"
                                    Visibility="Collapsed" HorizontalAlignment="Left" Padding="7,4"
                                    Foreground="{StaticResource Accent}" Background="{StaticResource Paper}"
                                    BorderBrush="{StaticResource Divider}"/>
                        </StackPanel>
                        <TextBlock x:Name="TextureDetails" Style="{StaticResource DetailText}" Margin="0,0,0,12"/>
                        <Menu x:Name="EditMenu" Style="{StaticResource CommandMenu}" HorizontalAlignment="Left"
                              Visibility="Collapsed">
                            <MenuItem Header="_Edit texture ▾" Style="{StaticResource MenuTrigger}"
                                      AutomationProperties.Name="Edit texture">
                                <MenuItem Header="_Import replacement…" Click="ImportReplacement"/>
                                <MenuItem x:Name="ConvertAction" Header="_Convert for TTPF export…" Click="ConvertForPool"
                                          Visibility="Collapsed"/>
                                <MenuItem x:Name="RevertAction" Header="_Revert replacement" Click="RevertReplacement"
                                          Visibility="Collapsed"/>
                            </MenuItem>
                        </Menu>
                        <TextBlock x:Name="EditDetails" Style="{StaticResource DetailText}" Margin="0,9,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
