<Application x:Class="ViceModVI.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#202C38"/>
        <SolidColorBrush x:Key="Muted" Color="#4D6073"/>
        <SolidColorBrush x:Key="Paper" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel" Color="#F3F6F8"/>
        <SolidColorBrush x:Key="Divider" Color="#D7E0E7"/>
        <SolidColorBrush x:Key="Accent" Color="#245775"/>
        <SolidColorBrush x:Key="Canvas" Color="#293744"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="PaneHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource Paper}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="CommandMenu" TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource Paper}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MenuTrigger" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
    </Application.Resources>
</Application>
